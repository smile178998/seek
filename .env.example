# ---------- 服务 ----------
SEEK_HOST=127.0.0.1
SEEK_PORT=8000
# Public deployment: set the real domain here (comma-separated if needed).
SEEK_ALLOWED_HOSTS=127.0.0.1,localhost
# Enable forwarded headers only behind a trusted reverse proxy.
SEEK_TRUST_PROXY_HEADERS=false
SEEK_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Enable only after HTTPS is working end to end.
SEEK_FORCE_HTTPS=false
SEEK_HSTS_ENABLED=false
# Disable interactive API documentation on an Internet-facing deployment.
SEEK_DOCS_ENABLED=true
SEEK_MAX_REQUEST_BYTES=32768

# ---------- 引擎 ----------
SEEK_CONCURRENCY=24
SEEK_TIMEOUT=12
SEEK_SSL_VERIFY=true
# reliable=白名单高可用模块；full=全部规则（噪声更大）
SEEK_SCAN_PROFILE=reliable
SEEK_AI_PROFILE=reliable

# ---------- 合规 ----------
SEEK_REQUIRE_CONSENT=true
SEEK_RATE_LIMIT_SCANS=12
SEEK_RATE_LIMIT_WINDOW=600
# SEEK_ALLOWED_DOMAINS=gmail.com,outlook.com

# ---------- 可选密钥 ----------
# HIBP_API_KEY=

# ---------- AI（OpenAI 兼容，如 DeepSeek）----------
# SEEK_AI_API_KEY=
# SEEK_AI_BASE_URL=https://api.deepseek.com/v1
# SEEK_AI_MODEL=deepseek-chat
